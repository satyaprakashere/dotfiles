# ==============================================================================
# 1. ROOT LEVEL: IGNORE EVERYTHING BY DEFAULT (STRICT ALLOWLIST)
# ==============================================================================
/*

# ==============================================================================
# 2. ALLOW REPOSITORY META & STANDALONE ROOT CONFIGS
# ==============================================================================
!.gitignore
!.gitmodules
!README.md
!starship.toml
!bashrc

# ==============================================================================
# 3. ALLOW CORE CONFIG DIRECTORIES
# ==============================================================================

!apprunner/
!apprunner/**

!CodeRunner/
!CodeRunner/**

!doom/
!doom/**

!fd/
!fd/**

!fish/
!fish/**

!ghostty/
!ghostty/**

!helix/
!helix/**

!nix-darwin
!nix-darwin/**

!nvim/
!nvim/**

!readme/
!readme/**

!shell/
!shell/**

!sublime-text/
!sublime-text/**

!tmux/
!tmux/**

!vim/
!vim/**

!zed/
!zed/**

# ==============================================================================
# 4. RE-IGNORE SECRETS, MACHINE STATE, RUNTIME CACHES & LOGS INSIDE ALLOWED DIRS
# ==============================================================================
# OS Metadata
**/.DS_Store
**/.AppleDouble
**/.LSOverride
**/Thumbs.db

# Secrets, Credentials, Keys & Machine-Specific State
fish_ai.ini
**/fish_ai.ini
fish/fish_variables
fish_variables
**/.env
**/.env.*
**/.envrc
**/*.pem
**/*.key
**/*.keystore
**/*.pkcs12
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*
**/id_dsa*
**/.authinfo*
**/.netrc
**/.git-credentials
**/credentials
**/credentials.json
**/*_token
**/*_secret
**/keys.txt
**/*.age
**/secrets/*.yaml
**/secrets/*.json
!**/secrets/.gitkeep
**/*_history
**/.bash_history
**/.zsh_history
**/.fish_history
**/gh/
**/backup/

# Editor & Plugin Caches / Lockfiles / Backups / Logs
**/*.log
**/*.bak
**/*.old
**/*backup*
**/*_backup.json
**/undo/
**/plugged/
**/.cache/
**/viminfo
**/last_session.vim
**/lazy-lock.json

# Tool-specific runtime/build ignores
alacritty/themes/
alire/indexes/community/repo/
apprunner/scratch/
helix/runtime
helix/runtime/
helix/runtime/**
helix/grammars/
zed/prompts/
sublime-text/Package Control.user-ca-bundle
nix/
nix-darwin/
emacs/
