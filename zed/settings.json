// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  // "enable_language_server": false,
  "proxy": "",
  "disable_ai": true,
  "agent_servers": {
    "qwen-code": {
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "tab_size": 4,
  "hard_tabs": false,
  "autosave": "on_focus_change",
  "title_bar": {
    // "show_user_menu": false,
    // "show_user_picture": false,
    // "show_branch_name": false,
    // "show_project_items": false
    "show_sign_in": false
  },
  "project_panel": {
    // "button": false
    "dock": "left",
    "hide_hidden": true
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Colored Zed Icons Theme Dark"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "buffer_font_family": "Monaco for Powerline",
  "base_keymap": "VSCode",
  "auto_update": false,
  "outline_panel": {
    "dock": "right"
  },
  "auto_update_extensions": {
    "json": false,
    "kotlin": false,
    // "java": false
  },
  "terminal": {
    // "button": false,
    "alternate_scroll": "off",
    "blinking": "terminal_controlled",
    "copy_on_select": true,
    "dock": "bottom",
    "default_height": 320,
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "default"
      }
    },
    "env": {},
    "font_family": "Hack Nerd Font Mono",
    "font_features": null,
    "font_size": null,
    "line_height": "comfortable",
    "option_as_meta": false,
    "shell": "system",
    "toolbar": {
      "breadcrumbs": true,
    },
    "working_directory": "current_project_directory",
    "scrollbar": {
      "show": null
    }
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "enable_feedback": false,
    "default_profile": "ask",
    "model_parameters": [],
    "default_model": {
      "enable_thinking": false,
      "provider": "ollama",
      "model": "qwen2.5-coder:7b"
    }
  },
  "file_scan_exclusions": [
    "**/.vscode",
    "**/node_modules",
    "**/.git",
    "**/*.hi",
    "**/*.o",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.*"
  ],
  "edit_predictions": {
    "provider": "none",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    // "enabled_in_text_threads": false
  },
  "theme": {
    "mode": "system",
    "light": "GitHub Dark Dimmed",
    "dark": "GitHub Dark Dimmed"
  },
  "vim_mode": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 18.0,
  "buffer_font_size": 18.0,
  "format_on_save": "off",
  "lsp": {
      "rekursion-lsp": {
         "binary": {
           "path": "rekursion",
           "arguments": ["lsp"]
         }
       },
      "gopls": {
        "initialization_options": {
                "buildFlags": ["-tags=goexperiment.arenas"]
        },
        // "env": {
        //     "GOEXPERIMENT": "arenas"
        // }
      },
    "clangd": {
          "binary": {
            "path": "clangd",
            "arguments": [
              "--compile-commands-dir=build",
              "--background-index",
              "--clang-tidy",
              "--all-scopes-completion",
              "--completion-style=detailed",
              "--header-insertion=never"
            ]
          }
    },
    // "json-language-server": {
    //     // "enable": false
    //     // "binary": {
    //     //     "path": "/dev/null"
    //     // }
    // },
    "jdtls": {
      // "initialization_options": {
      //   "arguments": [
      //     "--enable-preview"
      //   ]
      // },
      "binary": {
        "path" : "/opt/homebrew/bin/jdtls",
        "arguments": [ "--enable-preview" ]
      },
      "settings": {
        "java": {
            "compiler": {
                "problem": {
                "enablePreviewFeatures": "enabled",
                "reportPreviewFeatures": "ignore"
                }
            }
        }
        // "java_home": "~/.sdkman/candidates/java/current",
        // "lombok_support": true,
        // "check_updates": "always",
      }
    },
    // "hls": {
    //   "initialization_options": {
    //     "haskell": {
    //       "formattingProvider": "fourmolu"
    //     }
    //   }
    // },
    // "kotlin-lsp": {
    //   "binary": {
    //     "path": "/usr/local/bin/kotlin-lsp",
    //     "arguments": [ "--stdio" ]
    //   }
    // },
    // "zls": {
    //   "binary": {
    //     "path": "/opt/homebrew/bin/zls"
    //   }
    // },
    "rust-analyzer": {
      "enable_lsp_tasks": false,
      // "binary": {
      //   "path": "/opt/homebrew/bin/rust-analyzer"
      // },
      "initialization_options": {
        "checkOnSave": false,
        "cargo": {
          "allTargets": false
        },
        "check": {
          "workspace": false
        }
      }
    }
  },

  "languages": {
    "Rekursion": {
        "language_servers": ["rekursion-lsp"]
        },
    "C++": {
        "format_on_save": "on",
        // "use_setting_from_lsp": "clangd",
        // "tab_size": 4
    },
    "Python": {
      "language_servers": [
        "!basedpyright",
        // "!pylsp"
      ]
    },
    "Rust": {
        "language_servers": ["rust-glancer", "!rust-analyzer"]
      // "enable_language_server": false
    },
    "JSON": {
      "enable_language_server": false,
      "language_servers": []
    },
    "TypeScript": {
      "enable_language_server": false
    },
    // "Racket": {
    //   "enable_language_server": false
    // },
    // "Kotlin": {
    //   "language_servers": ["kotlin-lsp"]
    // }
  }
}
